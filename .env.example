# Copy to .env; generate independent random values. Never commit .env.
POSTGRES_DB=cctv
POSTGRES_USER=cctv
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://cctv:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/cctv
APP_ORIGIN=http://localhost:3000
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
# 64 hex chars (32 bytes), generated with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
MEDIAMTX_HLS_URL=http://127.0.0.1:8888
MEDIAMTX_API_URL=http://127.0.0.1:9997
API_INTERNAL_URL=http://127.0.0.1:4000
# Bootstrap only; not needed by running services. Use a password manager.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Absolute path to private MediaMTX config; use example for dummy only.
MEDIAMTX_CONFIG=./infra/mediamtx/mediamtx.yml
