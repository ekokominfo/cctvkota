  },
  "devDependencies": {"eslint": "^9.39.0", "typescript-eslint": "^8.46.0", "@eslint/js": "^9.39.0", "typescript": "^5.9.3", "@types/node": "^24.10.0", "@playwright/test": "^1.56.1"}
